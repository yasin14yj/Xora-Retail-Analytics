import pandas as pd
import numpy as np
from faker import Faker
import random

fake = Faker()

# 1. Product Data
products_list = [
    {'ProductID': 1, 'ProductName': 'Xero Pro', 'Category': 'Phone', 'Price': 3999},
    {'ProductID': 2, 'ProductName': 'Xero', 'Category': 'Phone', 'Price': 2999},
    {'ProductID': 3, 'ProductName': 'Xero Air', 'Category': 'Phone', 'Price': 1999},
    {'ProductID': 4, 'ProductName': 'Power Adaptor Phone', 'Category': 'Phone', 'Price': 299},
    {'ProductID': 5, 'ProductName': 'XeroPad Pro', 'Category': 'Tablet', 'Price': 3500},
    {'ProductID': 6, 'ProductName': 'XeroPad', 'Category': 'Tablet', 'Price': 2499},
    {'ProductID': 7, 'ProductName': 'Power Adaptor Tablet', 'Category': 'Tablet', 'Price': 259},
    {'ProductID': 8, 'ProductName': 'XeroWatch', 'Category': 'Watch', 'Price': 1499},
    {'ProductID': 9, 'ProductName': 'XeroPod Pro', 'Category': 'Earphone', 'Price': 1099},
    {'ProductID': 10, 'ProductName': 'XeroPod', 'Category': 'Earphone', 'Price': 699},
    {'ProductID': 11, 'ProductName': 'XeroPower Pro', 'Category': 'PowerBank', 'Price': 1199},
    {'ProductID': 12, 'ProductName': 'XeroPower', 'Category': 'PowerBank', 'Price': 599},
    {'ProductID': 13, 'ProductName': 'Xerobook Pro Max', 'Category': 'Laptop', 'Price': 5699},
    {'ProductID': 14, 'ProductName': 'Xerobook Pro', 'Category': 'Laptop', 'Price': 4999},
    {'ProductID': 15, 'ProductName': 'Xerobook', 'Category': 'Laptop', 'Price': 4099},
    {'ProductID': 16, 'ProductName': 'Xerobook Air', 'Category': 'Laptop', 'Price': 3599},
    {'ProductID': 17, 'ProductName': 'Xerobook Neo', 'Category': 'Laptop', 'Price': 2599},
    {'ProductID': 18, 'ProductName': 'Power Adaptor Laptop', 'Category': 'Laptop', 'Price': 399},
    {'ProductID': 19, 'ProductName': 'Type-c Long', 'Category': 'Cable', 'Price': 99},
    {'ProductID': 20, 'ProductName': 'Type-c Medium', 'Category': 'Cable', 'Price': 79},
    {'ProductID': 21, 'ProductName': 'Type-c Short', 'Category': 'Cable', 'Price': 49},
    {'ProductID': 22, 'ProductName': 'XeroMagic Mouse', 'Category': 'Accessories', 'Price': 299},
    {'ProductID': 23, 'ProductName': 'XeroMagic Trackpad', 'Category': 'Accessories', 'Price': 399},
    {'ProductID': 24, 'ProductName': 'XeroMagic Keyboard Pro', 'Category': 'Accessories', 'Price': 599},
    {'ProductID': 25, 'ProductName': 'XeroMagic Keyboard', 'Category': 'Accessories', 'Price': 399}
]
df_products = pd.DataFrame(products_list)

# 2. Store Data (Malaysia States)
states = ['Johor', 'Kedah', 'Kelantan', 'Melaka', 'Negeri Sembilan', 'Pahang', 'Pulau Pinang', 'Perak', 'Perlis', 'Sabah', 'Sarawak', 'Selangor', 'Terengganu', 'WPKL']
codes = ['MY-01', 'MY-02', 'MY-03', 'MY-04', 'MY-05', 'MY-06', 'MY-07', 'MY-08', 'MY-09', 'MY-12', 'MY-13', 'MY-10', 'MY-11', 'MY-14']
df_stores = pd.DataFrame({'StoreID': range(1, 15), 'State': states, 'StateCode': codes})

# 3. Customer Data (1000 Unique Customers)
df_customers = pd.DataFrame({'CustomerID': range(1001, 2001), 'CustomerName': [fake.name() for _ in range(1000)]})

# 4. Generate Sales (2 Years)
sales_data = []
for i in range(2000):
    cust = random.randint(1001, 2000)
    prod = random.choice(products_list)
    channel = random.choice(['Store', 'Online'])
    discount = 0.10 if channel == 'Online' else 0
    final_price = prod['Price'] * (1 - discount)
    
    sales_data.append({
        'OrderID': 5000 + i,
        'Date': fake.date_between(start_date='-2y', end_date='today'),
        'CustomerID': cust,
        'ProductID': prod['ProductID'],
        'StoreID': random.randint(1, 14),
        'SalesChannel': channel,
        'Quantity': random.randint(1, 2),
        'FinalPrice': round(final_price, 2)
    })
df_sales = pd.DataFrame(sales_data)

# Save
df_products.to_csv('Dim_Product.csv', index=False)
df_stores.to_csv('Dim_Store.csv', index=False)
df_customers.to_csv('Dim_Customer.csv', index=False)
df_sales.to_csv('Fact_Sales.csv', index=False)
